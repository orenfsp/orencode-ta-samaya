      ]
    },
    {
      "name": "Управление проектом",
      "pathPattern": "**/manage/**",
      "priorities": [
        {
          "condition": "name === 'Dockerfile'",
          "priority": 900
        },
        {
          "condition": "name === 'Dockerfile.dockerignore'",
          "priority": 899
        },
        {
          "condition": "name === 'entrypoint.sh'",
          "priority": 898
        },
        {
          "condition": "name === 'fsp.py'",
          "priority": 897
        },
        {
          "condition": "name === 'bootstrap.py'",
          "priority": 896
        },
        {
          "condition": "name === 'demo.py'",
          "priority": 894
        },
        {
          "condition": "name === 'demo_dictionaries.py'",
          "priority": 893
        },
        {
          "condition": "name === 'demo_calendar.py'",
          "priority": 892
        },
        {
          "condition": "name === 'demo_contests.py'",
          "priority": 891
        },
        {
          "condition": "name === 'demo_applications.py'",
          "priority": 890
        }
      ]
    },
    {
      "name": "Репозитории: сначала Postgres, потом Redis",
      "pathPattern": "**/repositories/**",
      "priorities": [
        {
          "condition": "name === 'pg_users.py'",
          "priority": 900
        },
        {
          "condition": "name === 'pg_user_roles.py'",
          "priority": 899
        },
        {
          "condition": "name === 'pg_audit_log.py'",
          "priority": 898
        },
        {
          "condition": "name === 'pg_dictionaries.py'",
          "priority": 897
        },
        {
          "condition": "name === 'pg_contests.py'",
          "priority": 896
        },
        {
          "condition": "name === 'pg_contest_history.py'",
          "priority": 895
        },
        {
          "condition": "name === 'pg_applications.py'",
          "priority": 894
        },
        {
          "condition": "name === 'pg_application_members.py'",
          "priority": 893
        },
        {
          "condition": "name === 'pg_calendar.py'",
          "priority": 892
        },
        {
          "condition": "name === 'pg_files.py'",
          "priority": 891
        },
        {
          "condition": "name.startsWith('pg_')",
          "priority": 800
        },
        {
          "condition": "name === 'red_sessions.py'",
          "priority": 700
        },
        {
          "condition": "name === 'red_login_attempts.py'",
          "priority": 699
        },
        {
          "condition": "name === 'red_forgot_requests.py'",
          "priority": 698
        },
        {
          "condition": "name === 'red_reset_tokens.py'",
          "priority": 697
        },
        {
          "condition": "name.startsWith('red_')",
          "priority": 600
        },
        {
          "condition": "name.startsWith('s3_')",
          "priority": 550
        },
        {
          "condition": "name.startsWith('http_')",
          "priority": 500
        }
      ]
    },
    {
      "name": "Бэкенд",
      "pathPattern": "**/backend/**",
      "priorities": [
        {
          "condition": "name === 'core'",
          "priority": 900
        },
        {
          "condition": "name === 'files'",
          "priority": 899
        },
        {
          "condition": "name === 'auth'",
          "priority": 898
        },
        {
          "condition": "name === 'audit'",
          "priority": 897
        },
        {
          "condition": "name === 'dictionaries'",
          "priority": 896
        },
        {
          "condition": "name === 'contests'",
          "priority": 895
        },
        {
          "condition": "name === 'applications'",
          "priority": 894
        },
        {
          "condition": "name === 'events'",
          "priority": 893
        },
        {
          "condition": "name === 'main.py'",
          "priority": 891
        },
        {
          "condition": "name === 'requirements.txt'",
          "priority": 890
        },
        {
          "condition": "name === 'repositories'",
          "priority": 600
        },
        {
          "condition": "name === 'domain'",
          "priority": 599
        },
        {
          "condition": "name === 'features'",
          "priority": 598
        },
        {
          "condition": "name === 'dependencies.py'",
          "priority": 597
        },
        {
          "condition": "name === 'read'",
          "priority": 550
        },
        {
          "condition": "name === 'manage'",
          "priority": 549
        },
        {
          "condition": "name === 'calendar'",
          "priority": 548
        },
        {
          "condition": "name === 'organizer'",
          "priority": 547
        },
        {
          "condition": "name === 'admin'",
          "priority": 546
        },
        {
          "condition": "name === 'upload'",
          "priority": 545
        },
        {
          "condition": "name === 'download'",
          "priority": 544
        },
        {
          "condition": "name === 'participant'",
          "priority": 543
        },
        {
          "condition": "name === 'moderation'",
          "priority": 542
        },
        {
          "condition": "name === 'public'",
          "priority": 541
        },
        {
          "condition": "name === 'router.py'",
          "priority": 500
        },
        {
          "condition": "name === 'schemas.py'",
          "priority": 499
        }
      ]
    }
  ],
  "python-envs.defaultEnvManager": "ms-python.python:venv"
}