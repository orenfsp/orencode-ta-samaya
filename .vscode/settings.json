{
  "ruff.enable": false,
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "python.analysis.extraPaths": [
    "backend",
    ".",
    "manage"
  ],
  "python.analysis.autoImportCompletions": true,
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingModuleSource": "none"
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.venv": true
  },
  "explorerSort.defaultSort": "name",
  "explorerSort.respectVsCodeExclude": true,
  "explorerSort.rules": [
    {
      "name": "Корень",
      "pathPattern": "**/*",
      "priorities": [
        {
          "condition": "name === 'manage'",
          "priority": 1000
        },
        {
          "condition": "name === 'infrastructure'",
          "priority": 999
        },
        {
          "condition": "name === 'backend'",
          "priority": 998
        },
        {
          "condition": "name === 'frontend'",
          "priority": 997
        },
        {
          "condition": "name === 'docs'",
          "priority": 996
        },
        {
          "condition": "name === '.vscode'",
          "priority": 995
        }
      ]
    },
    {
      "name": "Инфраструктура",
      "pathPattern": "**/infrastructure/**",
      "priorities": [
        {
          "condition": "name === 'base.py'",
          "priority": 900
        },
        {
          "condition": "name === 'enums.py'",
          "priority": 899
        },
        {
          "condition": "name === 'user.py'",
          "priority": 898
        },
        {
          "condition": "name === 'user_role.py'",
          "priority": 897
        },
        {
          "condition": "name === 'audit_log.py'",
          "priority": 896
        },
        {
          "condition": "name === 'file.py'",
          "priority": 895
        },
        {
          "condition": "name === 'dictionary_discipline.py'",
          "priority": 894
        },
        {
          "condition": "name === 'dictionary_municipality.py'",
          "priority": 893
        },
        {
          "condition": "name === 'dictionary_organization_type.py'",
          "priority": 892
        },
        {
          "condition": "name === 'dictionary_academic_group.py'",
          "priority": 891
        },
        {
          "condition": "name === 'dictionary_age_group.py'",
          "priority": 890
        },
        {
          "condition": "name === 'dictionary_contest_type.py'",
          "priority": 889
        },
        {
          "condition": "name === 'dictionary_contest_level.py'",
          "priority": 888
        },
        {
          "condition": "name === 'dictionary_contest_format.py'",
          "priority": 887
        },
        {
          "condition": "name === 'dictionary_rank_type.py'",
          "priority": 886
        },
        {
          "condition": "name === 'dictionary_judge_category.py'",
          "priority": 885
        },
        {
          "condition": "name === 'dictionary_judge_position.py'",
          "priority": 884
        },
        {
          "condition": "name === 'calendar_event.py'",
          "priority": 883
        },
        {
          "condition": "name === 'contest.py'",
          "priority": 882
        },
        {
          "condition": "name === 'contest_age_group.py'",
          "priority": 881
        },
        {
          "condition": "name === 'contest_academic_group.py'",
          "priority": 880
        },
        {
          "condition": "name === 'contest_photo.py'",
          "priority": 879
        },
        {
          "condition": "name === 'contest_status_history.py'",
          "priority": 878
        },
        {
          "condition": "name === 'contest_application.py'",
          "priority": 877
        },
        {
          "condition": "name === 'contest_application_member.py'",
          "priority": 876
